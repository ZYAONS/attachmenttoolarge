{
   "action": {
      "default_popup": "popup.html"
   },
   "background": {
      "service_worker": "./background.js",
      "type": "module"
   },
   "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self'"
   },
   "default_locale": "en",
   "description": "__MSG_appDesc__",
   "host_permissions": [ "http://*/*", "https://*/*" ],
   "icons": {
      "128": "images/icons/128x128-green.png",
      "16": "images/icons/19x19-grey.png",
      "32": "images/icons/19x19-grey.png",
      "48": "images/icons/48x48-green.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "__MSG_appName__",
   "permissions": [ "proxy", "tabs", "webRequest", "webRequestAuthProvider", "offscreen", "browsingData", "storage", "management", "alarms" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "2.0.18"
}
